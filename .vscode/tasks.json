{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${file}",
                "-o",
                "/tmp/bstu_${fileDirnameBasename}_${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "command": "g++",
                "args": [
                    "-fdiagnostics-color=always",
                    "-g",
                    "-std=c++17",
                    "${file}",
                    "-o",
                    "${env:TEMP}\\bstu_${fileDirnameBasename}_${fileBasenameNoExtension}.exe"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Собирает открытый файл в /tmp (Windows: %TEMP%). В репозитории не появляется ни build, ни exe."
        },
        {
            "label": "Run: active file",
            "detail": "Собрать и запустить открытый файл в терминале (с вводом с клавиатуры).",
            "type": "process",
            "command": "/tmp/bstu_${fileDirnameBasename}_${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "command": "${env:TEMP}\\bstu_${fileDirnameBasename}_${fileBasenameNoExtension}.exe"
            },
            "dependsOn": "C/C++: g++ build active file",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
